# Public browser configuration (set in Vercel Project Settings > Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only values: do not prefix with NEXT_PUBLIC_
# Keep payment credentials in Supabase Edge Function Secrets, not Vercel, unless server code explicitly needs them.
